rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Fetch couple document to verify partnership for storage paths
    function isPartnerInCouple(coupleId) {
      return isAuthenticated() && (request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.userIds);
    }

    // Strict Cloud Storage Rules for Couple Memories: ONLY the 2 paired users can access!
    match /couples/{coupleId}/{allPaths=**} {
      allow read, write: if isPartnerInCouple(coupleId);
    }

    // Cloud Storage Rules for Bug Report Screenshots: User can upload to their own userId folder
    // Public read/update/delete denied to protect privacy
    match /bugReports/{userId}/{allPaths=**} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read, update, delete: if false;
    }

    // Cloud Storage Rules for User Profile Photos: User can upload to their own folder, authenticated partners can read
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
