rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user owns the account document
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Check if request user is one of the two partners in a couple document
    function isPartnerInCouple(coupleData) {
      return isAuthenticated() && (request.auth.uid in coupleData.userIds);
    }

    // Helper function: Fetch couple document to verify partnership for subcollections
    function getCoupleData(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    // =========================================================================
    // USERS COLLECTION
    // Stores user profile info (name, email, coupleId, onboardingCompleted)
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId);
    }

    // =========================================================================
    // INVITES COLLECTION
    // Temporary 6-character codes used during the pairing flow
    // =========================================================================
    match /invites/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || request.resource.data.usedBy == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // =========================================================================
    // BUG REPORTS COLLECTION
    // Spoof-resistant feedback reporting: user can only submit reports matching their own UID
    // Read/update/delete denied to prevent public enumeration
    // =========================================================================
    match /bugReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // =========================================================================
    // COUPLES COLLECTION & SUBCOLLECTIONS
    // Strict isolation: ONLY the 2 paired user IDs listed in userIds array can access!
    // =========================================================================
    match /couples/{coupleId} {
      allow read: if isAuthenticated() && isPartnerInCouple(resource.data);

      allow create: if isAuthenticated() 
                    && request.resource.data.userIds.size() == 2 
                    && isPartnerInCouple(request.resource.data);

      allow update, delete: if isAuthenticated() && isPartnerInCouple(resource.data);

      // Explicit rules for Notifications subcollection (recipient-bound & spoof-resistant)
      match /notifications/{notifId} {
        allow create: if isAuthenticated() 
                      && isPartnerInCouple(getCoupleData(coupleId)) 
                      && request.resource.data.toUserId != request.auth.uid;
        allow read, update, delete: if isAuthenticated() 
                                    && isPartnerInCouple(getCoupleData(coupleId)) 
                                    && resource.data.toUserId == request.auth.uid;
      }

      // Explicit rules for Shared Moments subcollection
      match /moments/{momentId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Notice Board subcollection items
      match /noticeBoardItems/{itemId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Doodle Together subcollection items
      match /doodleItems/{itemId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Encrypted Chat Messages subcollection
      match /chatMessages/{messageId} {
        allow read, delete: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
        allow create: if isAuthenticated() 
                      && isPartnerInCouple(getCoupleData(coupleId)) 
                      && request.resource.data.senderUid == request.auth.uid;
        allow update: if isAuthenticated() 
                      && isPartnerInCouple(getCoupleData(coupleId)) 
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'delivered', 'updatedAt']);
      }

      // Explicit rules for Chat Typing indicator subcollection
      match /chatTyping/{userId} {
        allow read: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
        allow write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId)) && request.auth.uid == userId;
      }

      // Explicit rules for WebRTC Call Signaling (call/current & iceCandidates subcollection)
      match /call/current {
        allow read: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));

        // Create/Update to 'ringing' (New Offer): caller must be auth user, AND existing doc must not exist or be in terminal state
        allow create, update: if isAuthenticated() 
                              && isPartnerInCouple(getCoupleData(coupleId)) 
                              && request.resource.data.status == 'ringing'
                              && request.resource.data.callerId == request.auth.uid
                              && (resource == null || resource.data.status in ['idle', 'ended', 'rejected', 'missed']);

        // Accept ('active') or Decline ('rejected'): callee must be auth user
        allow update: if isAuthenticated() 
                      && isPartnerInCouple(getCoupleData(coupleId)) 
                      && resource.data.calleeId == request.auth.uid
                      && request.resource.data.status in ['active', 'rejected'];

        // End ('ended'), Missed ('missed'), or Reset ('idle'): caller or callee
        allow update: if isAuthenticated() 
                      && isPartnerInCouple(getCoupleData(coupleId)) 
                      && request.resource.data.status in ['ended', 'missed', 'idle'];
      }

      match /call/current/iceCandidates/{candidateId} {
        allow read, delete: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
        allow create: if isAuthenticated() 
                      && isPartnerInCouple(getCoupleData(coupleId)) 
                      && request.resource.data.fromUserId == request.auth.uid;
      }

      // Explicit rules for Private Hub subcollections (letters, memories, pinConfig)
      match /privateHub/{document=**} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Live Location sharing subcollection
      match /liveLocation/{userId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Answered Cards subcollection
      match /answeredCards/{cardId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Moods subcollection
      match /moods/{moodDocId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Games subcollections
      match /games/{gameType} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Presence subcollection
      match /presence/{userId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Music Stream subcollections (current & queue)
      match /music/current {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      match /musicQueue/{itemId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Fallback for all future nested collections under couples/{coupleId}
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }
    }

  }
}
