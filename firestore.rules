rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user owns the account document
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Check if request user is one of the two partners in a couple document
    function isPartnerInCouple(coupleData) {
      return isAuthenticated() && (request.auth.uid in coupleData.userIds);
    }

    // Helper function: Fetch couple document to verify partnership for subcollections
    function getCoupleData(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    // =========================================================================
    // USERS COLLECTION
    // Stores user profile info (name, email, coupleId, onboardingCompleted)
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId);
    }

    // =========================================================================
    // INVITES COLLECTION
    // Temporary 6-character codes used during the pairing flow
    // =========================================================================
    match /invites/{code} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // =========================================================================
    // BUG REPORTS COLLECTION
    // Spoof-resistant feedback reporting: user can only submit reports matching their own UID
    // Read/update/delete denied to prevent public enumeration
    // =========================================================================
    match /bugReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // =========================================================================
    // COUPLES COLLECTION & PRIVATE HUB / LIVE LOCATION / NOTICE BOARD SUBCOLLECTIONS
    // Strict isolation: ONLY the 2 paired user IDs listed in userIds array can access!
    // =========================================================================
    match /couples/{coupleId} {
      allow read: if isAuthenticated() && isPartnerInCouple(resource.data);

      allow create: if isAuthenticated() 
                    && request.resource.data.userIds.size() == 2 
                    && isPartnerInCouple(request.resource.data);

      allow update, delete: if isAuthenticated() && isPartnerInCouple(resource.data);

      // Explicit rules for Notice Board subcollection items (3-segment path: couples/{coupleId}/noticeBoardItems/{itemId})
      match /noticeBoardItems/{itemId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Private Hub subcollections (letters, memories, pinConfig)
      match /privateHub/{document=**} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Live Location sharing subcollection
      match /liveLocation/{userId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Answered Cards subcollection
      match /answeredCards/{cardId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Moods subcollection
      match /moods/{moodDocId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Games subcollections
      match /games/{gameType} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Explicit rules for Presence subcollection
      match /presence/{userId} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }

      // Fallback for all future nested collections under couples/{coupleId}
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && isPartnerInCouple(getCoupleData(coupleId));
      }
    }

  }
}
